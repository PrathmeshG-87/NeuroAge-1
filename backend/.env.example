APP_NAME=NeuroAge API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
# Optional for local development; production must provide a strong random secret.
# JWT_SECRET_KEY=
JWT_ISSUER=neuroage-local
JWT_AUDIENCE=neuroage
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=sqlite:///./storage/neuroage.db
CORS_ORIGINS=http://localhost:4173,http://localhost:5173
MODEL_SERVICE_URL=http://localhost:8001
MODEL_ARTIFACT_PATH=./storage/models/neuroage_3d_resnet18/best_model.pth
MODEL_NAME=NeuroAge-ResNet3D-18
MODEL_VERSION=kaggle-ixi-2026-10
MODEL_EVALUATION_METRICS_PATH=./storage/models/neuroage_3d_resnet18/evaluation_metrics.json
UPLOAD_DIRECTORY=./storage/uploads
REPORT_DIRECTORY=./storage/reports
DATASET_ROOT=./data/raw
DATASET_METADATA_PATH=./data/raw/metadata.csv
DATASET_DERIVED_DIR=./data/derived
MAX_UPLOAD_SIZE_BYTES=262144000
MAX_DECODED_VOXELS=32000000
UPLOAD_RETENTION_DAYS=30
REPORT_RETENTION_DAYS=30
AUTHENTICATION_REQUIRED=false
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BODY_BYTES=263192576
TRUSTED_PROXY_IPS=
